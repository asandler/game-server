<table>
  <thead>
    <tr>
      <th>Username</th>
      <th></th>
      <th></th>
      <th></th>
      <th>&nbsp;Add delay</th>
      <th></th>
      <th>&nbsp;&nbsp;Last send</th>
      <th>&nbsp;&nbsp;Delay</th>
      <th>&nbsp;&nbsp;Sends today</th>
      <th>&nbsp;&nbsp;Sends total</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.email, user %></td>
        <td><%= link_to 'Edit', edit_user_path(user) %></td>
        <td>| <%= link_to 'Delete', user, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        <td>| <%= link_to 'Undelay', undelay_path(user) %></td>
        <td>| <%= link_to '5 minutes', delay_path(user, 300) %></td>
        <td>| <%= link_to '1 hour', delay_path(user, 3600) %></td>
        <td>| <%= user.last_send_timestamp.in_time_zone("Moscow").to_s[0..-7] %></td>
        <td>| <%= [(user.next_send_timestamp - DateTime.now).to_i, 0].max %></td>
        <td>| <%= user.sends_today %></td>
        <td>| <%= user.sends_total %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to 'New user', new_user_path %>
